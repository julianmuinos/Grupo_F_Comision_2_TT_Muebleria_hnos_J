# Configuración del Servidor y Entorno - Mueblería Hermanos Jota
PORT=5000
NODE_ENV=development

# Clave Secreta para firma y verificación de JSON Web Tokens (JWT)
JWT_SECRET=muebleria_secret_key_2026_dev_hermanos_jota

# URL del Frontend (CORS) para producción (ej. https://tu-frontend.vercel.app)
# En desarrollo se permiten orígenes locales automáticamente
CLIENT_URL=http://localhost:5173

# Conexión a MongoDB Atlas (Reemplazar <usuario>, <password> y <cluster> con tus credenciales)
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/muebleria_hermanos_jota?retryWrites=true&w=majority

# Autenticación JWT (Configurar en .env local una clave secreta larga y segura; no hardcodear)
JWT_SECRET=reemplazar_por_una_clave_secreta_larga_y_segura
JWT_EXPIRES_IN=7d
